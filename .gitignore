# OpenTofu
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Secrets never live in this repo (they're in ~/.config/platform and ~/.config/qops)
*.pem
!stacks/vault-config/clusters/*.pub.pem
*.key
.env
.env.*
vault-init.json

# Editors / OS
.idea/
.vscode/
.DS_Store

# Python (tools/)
__pycache__/
.pytest_cache/

# Shared modules: the consuming stack locks the providers
modules/**/.terraform.lock.hcl
